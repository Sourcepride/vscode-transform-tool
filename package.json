{
  "name": "transform-tool",
  "displayName": "AnyConverter: JSON, TS, Zod, YAML",
  "description": "Instantly convert between JSON, TypeScript, Zod, GraphQL, YAML, and more. A high-performance transformation tool for modern developers.",
  "keywords": [
    "json to typescript",
    "json to zod",
    "json to graphql",
    "yaml to json",
    "json converter",
    "schema generator",
    "typescript",
    "zod",
    "transform",
    "converter",
    "curl to axios"
  ],
  "version": "0.0.5",
  "publisher": "Sourcepride",
  "icon": "assets/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sourcepride/vscode-transform-tool.git"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:transform-tool-tree"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "transform-tool",
          "title": "Transform",
          "icon": "assets/logo.svg"
        }
      ]
    },
    "views": {
      "transform-tool": [
        {
          "id": "transform-tool-tree",
          "name": "Tool"
        }
      ]
    },
    "commands": [
      {
        "command": "transform.start",
        "title": "Start tool",
        "category": "Transform Tool"
      },
      {
        "command": "transform-tools.processSelectedText",
        "title": "Transform Selected Text",
        "category": "Transform Tool"
      },
      {
        "command": "transform-tools.jsonToTypeScript",
        "title": "JSON to TypeScript",
        "category": "Transform Tool"
      },
      {
        "command": "transform-tools.jsonToZod",
        "title": "JSON to Zod Schema",
        "category": "Transform Tool"
      },
      {
        "command": "transform-tools.jsonToGraphQL",
        "title": "JSON to GraphQL",
        "category": "Transform Tool"
      },
      {
        "command": "transform-tools.jsonToMySQL",
        "title": "JSON to MySQL Schema",
        "category": "Transform Tool"
      },
      {
        "command": "transform-tools.jsonToMongoose",
        "title": "JSON to Mongoose Schema",
        "category": "Transform Tool"
      },
      {
        "command": "transform-tools.jsonToEnv",
        "title": "JSON to Environment (.env)",
        "category": "Transform Tool"
      },
      {
        "command": "transform-tools.jsonToCsv",
        "title": "JSON to CSV",
        "category": "Transform Tool"
      },
      {
        "command": "transform-tools.jsObjectToJson",
        "title": "JavaScript Object to JSON",
        "category": "Transform Tool"
      },
      {
        "command": "transform-tools.jsObjectToTypeScript",
        "title": "JavaScript Object to TypeScript",
        "category": "Transform Tool"
      },
      {
        "command": "transform-tools.csvToJson",
        "title": "CSV to JSON",
        "category": "Transform Tool"
      },
      {
        "command": "transform-tools.yamlToJson",
        "title": "YAML to JSON",
        "category": "Transform Tool"
      },
      {
        "command": "transform-tools.yamlToEnv",
        "title": "YAML to Environment (.env)",
        "category": "Transform Tool"
      },
      {
        "command": "transform-tools.yamlToToml",
        "title": "YAML to TOML",
        "category": "Transform Tool"
      },
      {
        "command": "transform-tools.tomlToYaml",
        "title": "TOML to YAML",
        "category": "Transform Tool"
      },
      {
        "command": "transform-tools.tomlToJson",
        "title": "TOML to JSON",
        "category": "Transform Tool"
      },
      {
        "command": "transform-tools.curlToNodeAxios",
        "title": "cURL to Node (axios)",
        "category": "Transform Tool"
      },
      {
        "command": "transform-tools.curlToNode",
        "title": "cURL to Node (fetch)",
        "category": "Transform Tool"
      },
      {
        "command": "transform-tools.curlToPython",
        "title": "cURL to Python (requests)",
        "category": "Transform Tool"
      },
      {
        "command": "transform-tools.curlToGo",
        "title": "cURL to Go",
        "category": "Transform Tool"
      },
      {
        "command": "transform-tools.curlToJava",
        "title": "cURL to Java",
        "category": "Transform Tool"
      },
      {
        "command": "transform-tools.htmlToReact",
        "title": "HTML to React (TSX)",
        "category": "Transform Tool"
      },
      {
        "command": "transform-tools.cssToTailwind",
        "title": "CSS to Tailwind",
        "category": "Transform Tool"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "transform-tools.processSelectedText",
          "when": "editorHasSelection",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "old:vscode:prepublish": "npm run compile",
    "compile": "tsc -b ./tsconfig.extension.json --force",
    "compile:all": "npm run compile && npm run vite:build",
    "watch": "tsc -b ./tsconfig.extension.json --watch",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "vite:build": "tsc -b && vite build",
    "vite:watch": "vite build --watch",
    "vite:preview": "vite preview",
    "vscode:prepublish": "npm run vite:build && npm run esbuild-base -- --minify",
    "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --external:curlconverter --format=cjs --platform=node",
    "esbuild": "npm run esbuild-base -- --sourcemap",
    "esbuild-watch": "npm run esbuild-base -- --sourcemap --watch",
    "test-compile": "tsc -b ./tsconfig.extension.json --force",
    "package": "vsce package"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.7.1",
    "@wasm-fmt/ruff_fmt": "^0.15.11",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "gofmt.js": "^0.0.2",
    "postcss": "^8.4.49",
    "prettier": "^3.8.3",
    "prettier-plugin-embed": "^0.4.15",
    "prettier-plugin-java": "^2.8.1",
    "prettier-plugin-sql": "^0.18.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.6",
    "vite-plugin-monaco-editor": "^1.1.0",
    "worker-loader": "^3.0.8"
  },
  "dependencies": {
    "@json2csv/plainjs": "^7.0.6",
    "@monaco-editor/react": "^4.6.0",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@sourcepride/json-to-env": "^1.0.1",
    "@sourcepride/yaml-to-env": "^1.0.0",
    "@xml-tools/parser": "^1.0.11",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convert-csv-to-json": "^4.38.0",
    "css-to-tailwind-translator": "^1.2.8",
    "curlconverter": "^4.12.0",
    "generate-schema": "^2.6.0",
    "graphql": "^16.10.0",
    "html-to-react": "^1.7.0",
    "json-schema-to-typescript": "^15.0.3",
    "json-schema-to-zod": "^2.6.0",
    "json-to-ts": "^2.1.0",
    "json-to-zod": "^1.1.2",
    "json5": "^2.2.3",
    "lucide-react": "^0.469.0",
    "monaco-editor": "^0.52.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "smol-toml": "^1.6.0",
    "sql-formatter": "^15.4.8",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "yaml": "^2.6.1",
    "zod-to-json-schema": "^3.24.1"
  }
}
